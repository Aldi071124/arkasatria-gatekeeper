# Copy to .env and fill in. NEVER commit a real .env.
# Port the server listens on locally (default 8080)
PORT=8080
# HMAC secret issued ONCE by the Agent Games dashboard ("Rotate Secret").
# The server reads it ONLY from here / the environment. Never hardcode it,
# never commit it, never paste it into chat or an AI tool.
AGENT_GAMES_HMAC_SECRET=
# HMAC signature format: hex (default) or sha256= — switch only if the
# platform rejects the preflight.
AGENT_GAMES_HMAC_FORMAT=hex
# How task_id maps to a circuit field element: keccak (default), numeric, hex.
GATEKEEPER_TASK_ID_MODE=keccak
